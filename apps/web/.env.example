# SpecTechMash web app (apps/web) — environment variables.
# Copy to `.env.local` and fill in the values.

# Public site origin: canonical URLs, OG, JSON-LD, robots.txt, sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://stm-import.ru

# Telegram bot username (without @) used for deep-links on the site.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=spectechmash_bot

# Public contact phone in international format. When set it is emitted in
# the AutoDealer JSON-LD (and can be reused by UI later). No fake defaults.
#NEXT_PUBLIC_CONTACT_PHONE=+7XXXXXXXXXX

# Catalog data source. "mock" (default) serves bundled fixtures — for local
# dev/tests. "http" fetches a managed JSON feed (production); the feed format
# is documented in lib/auction/README.md.
AUCTION_PROVIDER=mock
# Required when AUCTION_PROVIDER=http. The provider requests
# {AUCTION_API_BASE_URL}/brands.json and {AUCTION_API_BASE_URL}/lots.json.
#AUCTION_API_BASE_URL=https://data.stm-import.ru/feed

# Origin serving lot photos (absolute URLs in the feed's "photos" field).
# Added to next/image remotePatterns and preconnected in <head>.
#NEXT_PUBLIC_AUCTION_CDN_ORIGIN=https://cdn.stm-import.ru
