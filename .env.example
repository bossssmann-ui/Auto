# ─────────────────────────────────────────────────────────
# Тихоокеанская Звезда — Environment Variables
# Copy this file to `.env` and fill in the values.
# ─────────────────────────────────────────────────────────

# ── Telegram Bot Integration ──────────────────────────────
# 1. Open @BotFather in Telegram and create a new bot with /newbot.
# 2. Copy the HTTP API token provided by BotFather.
# 3. Send any message to the bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id (or group chat_id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── amoCRM Integration ────────────────────────────────────
# 1. Log in to your amoCRM account.
# 2. Go to Settings → Integrations → Create integration (type: External).
# 3. Use the long-lived access token provided after authorization.
# 4. Your domain is the subdomain, e.g. "mycompany" for mycompany.amocrm.ru.
# 5. (Optional) Specify a pipeline ID to route leads into a specific funnel.
AMOCRM_DOMAIN=
AMOCRM_ACCESS_TOKEN=
AMOCRM_PIPELINE_ID=

# ── YouTube (Frontend, optional) ──────────────────────────
# Used by the YouTubeGrid component to pull latest videos.
# Without these, hardcoded fallback videos will be shown.
VITE_YOUTUBE_CHANNEL_ID=
VITE_YOUTUBE_API_KEY=

# ── Server ────────────────────────────────────────────────
# Port for the lead API server (default: 3001)
PORT=3001

# CORS origin for the API. Use '*' for development or your
# production domain (e.g. https://pacific-star.ru) for production.
CORS_ORIGIN=*

# URL exposed to the frontend (Vite injects this at build time).
# In development: http://localhost:3001
# In production: your API domain or relative path.
VITE_API_URL=http://localhost:3001
