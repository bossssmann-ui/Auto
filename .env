# ─────────────────────────────────────────────────────────
# Тихоокеанская Звезда — Environment Variables
# Copy this file to `.env` and fill in the values.
# ─────────────────────────────────────────────────────────

# ── Telegram Bot Integration ──────────────────────────────
# 1. Open @BotFather in Telegram and create a new bot with /newbot.
# 2. Copy the HTTP API token provided by BotFather.
# 3. Send any message to the bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id (or group chat_id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── AI Telegram Bot (server/bot.ts) ──────────────────────
# A separate bot token for the AI assistant bot.
# Create another bot via @BotFather and paste its token here.
AI_BOT_TOKEN=8702959533:AAGFI0gUu3-0rvvTY6dHbQGtYtUwoVCpblg

# ── OpenRouter API (for AI sales assistant) ───────────────
# Used by the AI Telegram bot to power the Alexey persona.
# Get your API key from https://openrouter.ai/keys
OPENROUTER_KEY=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
# Model to use (default: anthropic/claude-3.5-sonnet).
OPENROUTER_MODEL=google/gemini-2.5-pro

# ── amoCRM Integration (OAuth 2.0) ────────────────────────
# 1. Log in to your amoCRM account.
# 2. Go to Settings → Integrations → Create integration (type: External).
# 3. Copy client_id and client_secret from the integration settings.
# 4. Set the redirect URI to match what you registered in amoCRM.
# 5. Your domain is the full subdomain, e.g. "mycompany.amocrm.ru".
# 6. (Optional) Specify a pipeline ID to route leads into a specific funnel.
# 7. See docs/amocrm-setup.md for detailed setup instructions.
AMOCRM_DOMAIN=
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URI=
AMOCRM_PIPELINE_ID=

# ── YouTube (Frontend, optional) ──────────────────────────
# Used by the YouTubeGrid component to pull latest videos.
# Without these, hardcoded fallback videos will be shown.
VITE_YOUTUBE_CHANNEL_ID=
VITE_YOUTUBE_API_KEY=

# ── Server ────────────────────────────────────────────────
# Port for the lead API server (default: 3001)
PORT=3001

# CORS origin for the API. Use '*' for development or your
# production domain (e.g. https://pacific-star.ru) for production.
CORS_ORIGIN=*

# URL exposed to the frontend (Vite injects this at build time).
# In development: http://localhost:3001
# In production: your API domain or relative path.
VITE_API_URL=http://localhost:3001
