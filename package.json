{
  "name": "auto",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "postcss": "^8.5.22",
    "sharp": "^0.35.0"
  },
  "scripts": {
    "dev": "npm run dev -w @auto/web",
    "build": "npm run build -w @auto/web",
    "lint": "eslint .",
    "dev:legacy": "vite",
    "build:legacy": "tsc -b && vite build",
    "preview:legacy": "vite preview",
    "dev:bot": "npm run dev -w @auto/bot",
    "test:bot": "BOT_TEST_MODE=1 tsx apps/bot/src/bot.test.ts && BOT_TEST_MODE=1 tsx apps/bot/src/calculator-link.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.8"
  }
}
