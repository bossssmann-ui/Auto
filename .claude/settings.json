{
  "defaultMode": "default",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./.git/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./secrets/**)",
      "Edit(./.git/**)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(curl * | sh)",
      "Bash(wget * | sh)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(git rebase *)",
      "Bash(git branch -D *)",
      "Bash(git checkout -f *)",
      "Bash(ssh *)",
      "Bash(scp *)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(pnpm add *)",
      "Bash(yarn add *)",
      "Bash(bun add *)",
      "Bash(docker *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(git pull *)",
      "Bash(npm run *)",
      "Bash(pnpm run *)",
      "Bash(yarn *)",
      "Bash(bun run *)",
      "Edit(./package.json)",
      "Edit(./package-lock.json)",
      "Edit(./pnpm-lock.yaml)",
      "Edit(./yarn.lock)",
      "Edit(./bun.lockb)"
    ],
    "allow": [
      "Read(./**)",
      "Edit(./server/**)",
      "Edit(./src/**)",
      "Edit(./public/**)",
      "Edit(./docs/**)",
      "Edit(./README.md)",
      "Edit(./index.html)",
      "Edit(./vite.config.ts)",
      "Edit(./tsconfig.json)",
      "Edit(./tsconfig.app.json)",
      "Edit(./tsconfig.node.json)",
      "Edit(./eslint.config.js)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(cat README.md)",
      "Bash(git status)",
      "Bash(git diff *)"
    ]
  }
}
